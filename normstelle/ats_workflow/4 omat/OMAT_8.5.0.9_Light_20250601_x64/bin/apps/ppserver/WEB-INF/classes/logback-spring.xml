<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/base.xml"/>
	<include file="${cor.configdir}/logback-include.xml"/>
	<include file="${cor.configdir}/logback-pp-json.xml" optional="true"/>

     <!--This property need to match with what is happening in PinpointServerApplication.setLogDir() -->
    <property name="log-path" value="${cor.logdir:-${java.io.tmpdir:-/tmp}/logs}"/>
    
	<appender name="pinpoint_server_performance" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_performance.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_performance-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server_sync" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_sync.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_sync-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server_imports" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_imports.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_imports-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server_log" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_log.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_log-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server_service" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_service.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_service-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server_rest" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_rest.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_rest-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
			<pattern>[%d{yyyy-MM-dd HH:mm:ss}] %5p [%t] %c{2\}:%L - %m%n</pattern>
		</encoder>
	</appender>

	<appender name="pinpoint_server_hibernate" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${log-path}/pinpoint_server_hibernate.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${log-path}/logs/pinpoint_server_hibernate-%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>7</maxHistory>
		</rollingPolicy>
		<encoder>
