.add     { background-color: #99FF99; }
.delete  { text-decoration: line-through;
            background-color: #FF7F7F; }
.modify  { background-color: #FFFF99; }
.COC        { background-color: #87ceea; }
.commercialClassification  { background-color: #32CD32; }
  .coc_changeMark { background-color: #006000; }
.delete_coc_changemark { text-decoration: line-through;
                 background-color: #006000; }
.addCOC       { border-style:solid; border-width:4px; border-color: #87ceea;
              background-color: #006400; }
.deleteCOC    { border-style:solid; border-width:4px; border-color: #87ceea;
              text-decoration: line-through;
              background-color: #FF7F7F; }
.modifyCOC    { border-style:solid; border-width:4px; border-color: #87ceea;  
              background-color: #F7FC62; }
tr.addCOC    td { border-style:solid; border-width:4px; border-color: #87ceea;
              background-color: #006400; }
tr.deleteCOC td { border-style:solid; border-width:4px; border-color: #87ceea;
              text-decoration: line-through;
              background-color: #FF7F7F; }
tr.modifyCOC td { border-style:solid; border-width:4px; border-color: #87ceea;  
              background-color: #F7FC62; }

