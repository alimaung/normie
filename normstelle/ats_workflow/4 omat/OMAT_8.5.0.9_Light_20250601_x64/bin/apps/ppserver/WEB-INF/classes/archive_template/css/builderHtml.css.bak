body,table,th,td,div,span,p,a
{
  font-family:arial,helvetica,sans-serif;font-size:10pt;margin:0pt;
  line-height:20pt;
  color:inherit;
}

div {
overflow:hidden;
}

.applic-nowrap{
    word-break:break-all;word-wrap:break-word
}

.area-start
{
  width:12%;
}

.area-end
{
  width:7%;
}

.image-area
{
    width:100%;
    
}
.page-footer
{
  width:100%;
  border-top:solid 1px black;
}

.centerhead1-h
{font-size:14pt;font-weight:bold;text-align:center;padding-bottom:15pt;}

.centerhead1-t
{font-size:14pt;font-weight:bold;text-align:center;padding-bottom:10pt;}

.centerhead2-h
{font-size:14pt;font-weight:bold;font-style:italic;text-align:center;padding-bottom:15pt;}

.centerhead2-t
{font-size:14pt;font-weight:bold;font-style:italic;text-align:center;padding-bottom:10pt;}

.centerhead2-r
{font-size:14pt;font-weight:bold;text-align:center;padding-bottom:5pt;}

.centerhead-text-to-heading
{padding-top:27pt;}

.centerhead-table-to-heading
{padding-top:35pt;}

.sidehead0-h
{font-size:14pt;font-weight:bold;}

.sidehead0-t
{font-size:14pt;font-weight:bold;}

.sidehead1
{
 font-size:14pt;font-weight:bold;text-align:left;
}

.sidehead2
{font-size:12pt;font-weight:bold;text-align:left;}

.sidehead3
{font-size:11pt;font-weight:bold;text-align:left;}

.sidehead4
{font-size:11pt;text-align:left;}

.sidehead5
{font-size:11pt;text-align:left;}

.tab-pg-area
{width:210mm}

.tab-img-area
{width:25mm}

.tab-type-area
{width:30mm}

table#containerTable td {padding-top: 0.5em;}

.tocEntry
{background: transparent url(dots.gif) center left repeat-x; width:87% ;text-align: left;}
/*10% left for page number*/

.item
{background-color: white;  padding-right: 0.5em;}

.pageNum
{text-align: right; vertical-align: bottom; width:10%;align:right;}

.sidehead1Num
{width:3%;}

.simpleNum
{width:12%
 text-align:left
}
.randListTitle
{
 text-align:left;font-weight:bold;padding-bottom:4;
}

.figureTitle
{
 text-align:center;font-weight:bold;font-style:italic;
}

.ndash
{
 margin: 0;padding-left: 15;padding-top:4pt;list-style: url(ndash.jpg) square;
}

.randListSimple
{
 margin: 0;padding-left: 15;padding-top:4pt;list-style: none;
}

.type-area-content
{
  font-size:10pt;width:
  79%;
}

.caution-warning-spec 
{
	padding: 10px;
	background:white;
	border: 3px solid black;
	border-radius: 10px;
}

.caution-warning-spec .title
{
	vertical-align: top;
	text-decoration: underline;
	font-weight: bold;
}

.caution-warning-spec .content
{
	padding-left: 50px;
}

.caution-warning-outer-border 
{
	-moz-border-radius: 7px;
	-webkit-border-radius: 7px;
	-khtml-border-radius: 7px;
	border-radius: 7px;

	border: 1px solid black;
	margin-top: 14px;
	margin-bottom: 14px;
}

.warning, .warningSpec
{
  -moz-border-radius: 7px;
  -webkit-border-radius: 7px;
  -khtml-border-radius: 7px;
  border-radius: 7px;
  padding:15px;
  page-break-inside: avoid;
  border:1pt solid black;
  background-image:url(data:image/gif;base64,
}

.caution, .cautionSpec{
  -moz-border-radius: 7px;
  -webkit-border-radius: 7px;
  -khtml-border-radius: 7px;
   border-radius: 7px;
   padding:15px;
   page-break-inside: avoid;
   border:1pt solid black;
   background-image:url(data:image/gif;base64,
}

.wc-text-area {
-moz-border-radius: 7px;
-webkit-border-radius: 7px;
-khtml-border-radius: 7px;
border-radius: 7px;
background:white;
border:1pt solid black;
}

.warning-caution-caption
{
  font-size:14;
  font-weight:bold;
  text-align:center;
}

.warning-caution-label{
text-decoration:underline;font-weight:bold;
font-size:14pt
}

.warning-caution-content{
text-align:left;font-weight:bold;text-transform: uppercase;
}

.tableTitle
{
  font-weight:bold;
  text-align:center;
}
.italic
{
  font-style:italic;
}

.bordercell, .spectable td
{
  border-style:solid;
  border-color: black;
  border-width: 1px;
  width : 200px;
  /*border-top:solid 1px black;
  border-bottom:solid 1px black;*/
}

.indent
{
  margin-left: 20px;
}

.spectable
{
  width: 100%;
  border-collapse: collapse;
}

