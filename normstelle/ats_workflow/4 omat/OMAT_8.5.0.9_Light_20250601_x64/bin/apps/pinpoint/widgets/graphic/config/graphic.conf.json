        "x3dButtons": [
            {
                "name": "reset",
                "titlekey": "graphic.title.reset",
                "icon": "fa-refresh",
                "isHidden": false,
                "class": "x3d-button",
                "action": "resetX3DNav"
            },
            {
                "name": "resetZoom",
                "titlekey": "graphic.title.default",
                "icon": "fa-camera",
                "isHidden": false,
                "class": "x3d-button",
                "action": "resetZoom"
            },
            {
                "name": "leftView",
                "titlekey": "graphic.title.left",
                "icon": "fa-chevron-left",
                "isHidden": false,
                "isDisabled": false,
                "class": "x3d-button",
                "action": "leftView"
            },
            {
                "name": "topView",
                "titlekey": "graphic.title.top",
                "icon": "fa-chevron-up",
                "isHidden": false,
                "class": "x3d-button",
                "action": "topView"
            },
            {
                "name": "bottomView",
                "titlekey": "graphic.title.bottom",
                "icon": "fa-chevron-down",
                "isHidden": false,
                "class": "x3d-button",
                "action": "bottomView"
            },
            {
                "name": "rightView",
                "titlekey": "graphic.title.right",
                "icon": "fa-chevron-right",
                "isHidden": false,
                "class": "x3d-button",
                "action": "rightView"
            },
            {
                "name": "hiddenItems",
                "titlekey": "graphic.title.hiddenItems",
                "icon": "fa-eye-slash",
                "isHidden": false,
                "class": "x3d-button",
                "action": "closeSidebarGraphic"
            },
            {
                "name": "goBack",
                "titlekey": "graphic.title.goBack",
                "icon": "fa-undo",
                "isHidden": false,
                "class": "x3d-button goback-button disabled",
                "action": "prevFocusNode"
            }
