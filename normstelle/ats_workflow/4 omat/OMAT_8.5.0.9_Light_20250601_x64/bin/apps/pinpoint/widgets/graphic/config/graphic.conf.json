        "hideMenus":{
            "pdfIE":[
                "rotateGraphic",
                "zoomOutGraphic",
                "zoomInGraphic",
                "zoomPan",
                "zoomSelectAreaGraphic",
                "refreshGraphic",
                "findGraphic",
                "popupGraphic",
                "Annotation",
                "printGraphic"
            ],
            "pdfNonIE":[
                "findGraphic",
                "popupGraphic",
                "Annotation",
                "printGraphic"
            ],
            "svg":[
                "printGraphic",
                "zoomPan"
            ]
        }
