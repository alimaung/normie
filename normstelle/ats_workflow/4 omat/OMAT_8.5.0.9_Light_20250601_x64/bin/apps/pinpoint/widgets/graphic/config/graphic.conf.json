            {
                "name": "zoomOutGraphic",
                "titlekey": "graphic.title.zoomout",
                "icon": "fa-search-minus",
                "action": "zoomOut"
            },
            {
                "name": "rotateGraphic",
                "titlekey": "graphic.title.rotate",
                "icon": "fa-repeat",
                "action": "rotateGraphic"
            }
