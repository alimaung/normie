                "action": "findGraphic"
            },
            {
                "name": "printGraphic",
                "titlekey": "graphic.title.printgraphic",
                "icon": "fa-print",
                "isHidden" : true,
                "action": "printGraphic"
            }
        ],
        "rightMenus": [
            {
                "name": "Annotation",
                "titlekey": "graphic.title.createannotation",
                "icon": "fa-pencil-square-o",
                "action": "createGraphicAnnotation"
            },
            {
                "name": "List Graphic",
                "titlekey": "graphic.title.figurelist",
                "icon": "fa-picture-o",
                "action": "showGraphicList"
            },
            {
                "name": "openPdfInNewBrowserWindow",
                "titlekey": "graphic.title.openPdfInNewBrowserWindow",
                "icon": "fa-external-link",
                "action": "openPdfInNewBrowserWindow",
                "isHidden" : true
            },
            {
                "name": "popupGraphic",
                "titlekey": "graphic.title.opengraphicinnewwindow",
                "icon": "fa-external-link",
                "action": "popupGraphic"
            },
            {
                "name": "downloadSheet",
