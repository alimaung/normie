CREATE MEMORY TABLE PUBLIC.PINPOINT_ORG_REV_MERGE(MERGE_ID INTEGER NOT NULL PRIMARY KEY,NCAGE VARCHAR(5),LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),REVISION_NUMBER INTEGER,SOURCE_REVISION_NUMBER INTEGER,CONFLICTS INTEGER,STATUS VARCHAR(50),CREATE_TIME TIMESTAMP DEFAULT LOCALTIMESTAMP,UPDATE_TIME TIMESTAMP DEFAULT LOCALTIMESTAMP,APPROVED_BY VARCHAR(50),APPROVED_TIME TIMESTAMP DEFAULT LOCALTIMESTAMP,COMMENTS VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.PINPOINT_ORG_REV_MERGE_DOC(MERGE_ID INTEGER,KEY VARCHAR(255),PREVIOUS_DOCUMENT_ID INTEGER,CURRENT_DOCUMENT_ID INTEGER,AUTHORED_DOCUMENT_ID INTEGER,DRAFT_DOCUMENT_ID INTEGER,STATUS VARCHAR(50),TITLE VARCHAR(16777216),HISTORY VARCHAR(16777216),OEM_CHANGES_COUNT INTEGER,PRIMARY KEY(MERGE_ID,KEY),CONSTRAINT PINPOINT_ORG_REV_MERGE_DOC_FK1 FOREIGN KEY(MERGE_ID) REFERENCES PUBLIC.PINPOINT_ORG_REV_MERGE(MERGE_ID),CONSTRAINT PINPOINT_ORG_REV_MERGE_DOC_FK2 FOREIGN KEY(PREVIOUS_DOCUMENT_ID) REFERENCES PUBLIC.PINPOINT_DOCUMENT(DOCUMENT_ID),CONSTRAINT PINPOINT_ORG_REV_MERGE_DOC_FK3 FOREIGN KEY(CURRENT_DOCUMENT_ID) REFERENCES PUBLIC.PINPOINT_DOCUMENT(DOCUMENT_ID),CONSTRAINT PINPOINT_ORG_REV_MERGE_DOC_FK4 FOREIGN KEY(AUTHORED_DOCUMENT_ID) REFERENCES PUBLIC.PINPOINT_DOCUMENT(DOCUMENT_ID),CONSTRAINT PINPOINT_ORG_REV_MERGE_DOC_FK5 FOREIGN KEY(DRAFT_DOCUMENT_ID) REFERENCES PUBLIC.PINPOINT_USER_DOCUMENT(DOCUMENT_ID))
CREATE MEMORY TABLE PUBLIC.ACM_TOKEN(JWT VARCHAR(4000) NOT NULL PRIMARY KEY,CREATETIME TIMESTAMP NOT NULL,EXPIRETIME TIMESTAMP NOT NULL,USERNAME VARCHAR(50) NOT NULL,CONSTRAINT ACM_TOKEN_USER_FK FOREIGN KEY(USERNAME) REFERENCES PUBLIC.ACM_USER(USERNAME))
CREATE VIEW PUBLIC.VIEW_USERGROUPRESOURCE (URI,USERGROUPID,NAME,DEFAULT_FOR_DESCENDANTS) AS SELECT URI,USERGROUPID,NAME,DEFAULT_FOR_DESCENDANTS FROM PUBLIC.ACM_USERGROUPRESOURCE
CREATE MEMORY TABLE PUBLIC.PINPOINT_USER_STYLE(USER_ID VARCHAR(255) NOT NULL PRIMARY KEY,ATA_STYLE BOOLEAN)
CREATE MEMORY TABLE PUBLIC.PINPOINT_USER_PUBLICATION_CONF(USERNAME VARCHAR(255),LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),PREFERRED_REVISION INTEGER,PRIMARY KEY(USERNAME,LIBRARY_ID,PUBLICATION_ID))
CREATE MEMORY TABLE PUBLIC.PINPOINT_SYNC_WAITINGLIST(ID INTEGER NOT NULL PRIMARY KEY,PUBLICATION_ID VARCHAR(255),PUBLICATION_TITLE VARCHAR(16777216),PUBLICATION_DESCRIPTION VARCHAR(16777216),PUBLICATION_NAME VARCHAR(255),LIBRARY_ID VARCHAR(255),LIBRARY_TITLE VARCHAR(255),LIBRARY_ID_CHAIN VARCHAR(16777216),REVISION_ID VARCHAR(255),REVISION_NUMBER INTEGER,REVISION_DATE VARCHAR(255),REVISION_TYPE VARCHAR(255),PACKAGE_SIZE BIGINT,URL VARCHAR(16777216),STATUS VARCHAR(255),UPDATED TIMESTAMP DEFAULT LOCALTIMESTAMP,SYNC_DATE TIMESTAMP DEFAULT LOCALTIMESTAMP,IS_CURRENT BOOLEAN,PUB_TYPE VARCHAR(255),ACM_URI VARCHAR(500),PUBLICATION_STATUS VARCHAR(255) DEFAULT 'Draft',MANUFACTURER VARCHAR(255),METADATA VARCHAR(16777216),LANDING_URL VARCHAR(255),ACKNOWLEDGEMENT BOOLEAN DEFAULT FALSE,IS_SOURCE_PINPOINT BOOLEAN DEFAULT FALSE,LOCAL_FOLDER VARCHAR(255) DEFAULT '',DUE_PERIOD VARCHAR(255),EXPIRY_PERIOD VARCHAR(255),ISEXPIRED BOOLEAN DEFAULT FALSE,AIRLINE_REVISION_NUMBER VARCHAR(10),REVIEW_COMMENT VARCHAR(16777216),IS_EXPORT_CONTROL_ENABLED BOOLEAN DEFAULT FALSE,EXPORT_CONTROL_MESSAGE VARCHAR(16777216),PREVIEW BOOLEAN DEFAULT FALSE,NCAGE VARCHAR(5),TRACK_AUDITS BOOLEAN DEFAULT TRUE,CHANGED_DOCUMENTS INTEGER,CUSTOMIZED_REVISION_DATE VARCHAR(255),CUSTOMIZED_REVISION_NUMBER VARCHAR(255),SOURCE_PUBLICATION_ID VARCHAR(255))
CREATE INDEX IDX_LIB_PUB_REV_WAITING ON PUBLIC.PINPOINT_SYNC_WAITINGLIST(LIBRARY_ID,PUBLICATION_ID,REVISION_NUMBER)
CREATE INDEX IDX_LIB_PUB_STATUS_WAITING ON PUBLIC.PINPOINT_SYNC_WAITINGLIST(STATUS)
CREATE INDEX IDX_LIB_PUB_TYPE_WAITING ON PUBLIC.PINPOINT_SYNC_WAITINGLIST(PUBLICATION_NAME)
CREATE MEMORY TABLE PUBLIC.PINPOINT_PRODUCT_CONFIGURATION(PRODUCT_ID INTEGER NOT NULL PRIMARY KEY,LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),LABEL VARCHAR(16777216),DISPLAY_TEMPLATE VARCHAR(255),CHECK_SUM VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.PINPOINT_SCHEDULE_REV_RELEASE(ID INTEGER NOT NULL PRIMARY KEY,LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),REVISION_ID VARCHAR(255),REVISION_NUMBER INTEGER,SCHEDULED_TIME VARCHAR(255),USER_GROUPS VARCHAR(255),RELEASE_COMMENTS VARCHAR(255),STATUS VARCHAR(255),CREATED TIMESTAMP,UPDATED TIMESTAMP,CREATED_BY VARCHAR(255),UPDATED_BY VARCHAR(255))
CREATE UNIQUE INDEX IDX_SCHEDULE_REV_RELEASE ON PUBLIC.PINPOINT_SCHEDULE_REV_RELEASE(LIBRARY_ID,PUBLICATION_ID,REVISION_NUMBER)
CREATE VIEW PUBLIC.IMPORTOVERVIEW_VIEW (ID,METADATA,MANUFACTURER,REVISION_DATE,REVISION_NUMBER,PUBLICATION_ID,PUBLICATION_TITLE,LIBRARY_ID,LIBRARY_TITLE,STATUS,LOCAL_FOLDER,UPDATED,IS_SOURCE_PINPOINT,IS_CURRENT,NCAGE,AIRLINE_REVISION_NUMBER,CUSTOMIZED_REVISION_NUMBER) AS (SELECT ROWNUM()AS ID,METADATA,MANUFACTURER,REVISION_DATE,REVISION_NUMBER,PUBLICATION_ID,PUBLICATION_TITLE,LIBRARY_ID,LIBRARY_TITLE,STATUS,LOCAL_FOLDER,UPDATED,IS_SOURCE_PINPOINT,IS_CURRENT,NCAGE,AIRLINE_REVISION_NUMBER,CUSTOMIZED_REVISION_NUMBER FROM PUBLIC.PINPOINT_LIBRARY_PUBLICATION ORDER BY REVISION_NUMBER)UNION(SELECT CAST(ROWNUM()+(SELECT COUNT(*)FROM PUBLIC.PINPOINT_LIBRARY_PUBLICATION)AS INTEGER)AS ID,METADATA,MANUFACTURER,REVISION_DATE,REVISION_NUMBER,PUBLICATION_ID,PUBLICATION_TITLE,LIBRARY_ID,LIBRARY_TITLE,STATUS,LOCAL_FOLDER,UPDATED,IS_SOURCE_PINPOINT,IS_CURRENT,NCAGE,AIRLINE_REVISION_NUMBER,CUSTOMIZED_REVISION_NUMBER FROM PUBLIC.PINPOINT_SYNC_WAITINGLIST ORDER BY REVISION_NUMBER)
CREATE MEMORY TABLE PUBLIC.PINPOINT_ARCHIVE_JOB(ID INTEGER NOT NULL PRIMARY KEY,LIBRARY_ID VARCHAR(255),LIBRARY_TITLE VARCHAR(255),PUBLICATION_ID VARCHAR(255),PUBLICATION_TITLE VARCHAR(255),REVISION_ID VARCHAR(255),REVISION_NUMBER INTEGER,CREATED TIMESTAMP NOT NULL,STATUS VARCHAR(50),LOCATION VARCHAR(255),URL VARCHAR(255),DM_ARCHIVE_STATUS VARCHAR(50),ORPHAN_DATE TIMESTAMP)
CREATE MEMORY TABLE PUBLIC.PINPOINT_RESTRICTED_FRAGMENT(FRAGMENT_ID INTEGER NOT NULL PRIMARY KEY,LIBRARY_ID VARCHAR(255),LIBRARY_TITLE VARCHAR(1000),PUBLICATION_ID VARCHAR(255),PUBLICATION_TYPE VARCHAR(1000),DOCUMENT_KEY VARCHAR(255),DOCUMENT_TITLE VARCHAR(1000))
CREATE UNIQUE INDEX IDX_RESTRICTED_FRAGMENT ON PUBLIC.PINPOINT_RESTRICTED_FRAGMENT(LIBRARY_ID,PUBLICATION_ID,DOCUMENT_KEY)
CREATE MEMORY TABLE PUBLIC.PINPOINT_USER_FRAGMENT(ID INTEGER NOT NULL PRIMARY KEY,FRAGMENT_ID INTEGER,USER_GROUP VARCHAR(100),USER_GROUP_ORGANIZATION VARCHAR(100),UNIQUE(FRAGMENT_ID,USER_GROUP),CONSTRAINT PINPOINT_USER_FRAGMENT_FK FOREIGN KEY(FRAGMENT_ID) REFERENCES PUBLIC.PINPOINT_RESTRICTED_FRAGMENT(FRAGMENT_ID) ON DELETE CASCADE)
CREATE UNIQUE INDEX IDX_PINPOINT_USER_FRAGMENT ON PUBLIC.PINPOINT_USER_FRAGMENT(FRAGMENT_ID,USER_GROUP,USER_GROUP_ORGANIZATION)
ALTER TABLE PUBLIC.ACM_GROUPINGROUPMEMBER ADD CONSTRAINT FKPJQ3QC9N935W0H1LCMP2TYLF9 FOREIGN KEY(USERGROUP) REFERENCES PUBLIC.ACM_USERGROUP(USERGROUPID)
ALTER TABLE PUBLIC.ACM_GROUPINGROUPMEMBER ADD CONSTRAINT FK1Q5SL5R0K1PLQUDO7BXFG747 FOREIGN KEY(PARENTGROUP) REFERENCES PUBLIC.ACM_USERGROUP(USERGROUPID)
ALTER TABLE PUBLIC.ACM_LOCK ADD CONSTRAINT FKT1YNT5M1LC2GF3SWER92C0WNK FOREIGN KEY(USERNAME) REFERENCES PUBLIC.ACM_USER(USERNAME)
