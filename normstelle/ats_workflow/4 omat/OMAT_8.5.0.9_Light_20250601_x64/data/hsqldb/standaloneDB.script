CREATE UNIQUE INDEX IDX_NCAGE_LIB_PUB ON PUBLIC.PINPOINT_ORG_PUBLICATION_CONF(NCAGE,LIBRARY_ID,PUBLICATION_ID)
CREATE MEMORY TABLE PUBLIC.PINPOINT_PRODUCT_MAPPING(ID INTEGER NOT NULL,CUSTOMER VARCHAR(5),PRODUCT_ID INTEGER NOT NULL,LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),CONSTRAINT PK_PINPOINT_PRODUCT_MAPPING PRIMARY KEY(ID),CONSTRAINT PIPOINT_PRODUCT_MAPPING_FK1 FOREIGN KEY(PRODUCT_ID) REFERENCES PUBLIC.PINPOINT_PRODUCT_LIST(PRODUCT_ID))
CREATE UNIQUE INDEX IDX_CUSTOMER_LIB_PUB_PRODUCT ON PUBLIC.PINPOINT_PRODUCT_MAPPING(CUSTOMER,LIBRARY_ID,PUBLICATION_ID,PRODUCT_ID)
