CREATE MEMORY TABLE PUBLIC.ACM_SECRET_KEY(SECRET_KEY_ID VARCHAR(100),PUBLIC_KEY_ID VARCHAR(100),PASSPHRASE VARCHAR(100),SECRET_KEY_FILE_CONTENT VARCHAR(16777216),PUBLIC_KEY_FILE_CONTENT VARCHAR(16777216))
