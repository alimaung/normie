CREATE MEMORY TABLE PUBLIC.PINPOINT_FF_FAULT_ROW(ID INTEGER NOT NULL PRIMARY KEY,GROUP_ID VARCHAR(255),CHANGE VARCHAR(255),REVDATE VARCHAR(255),FILTER_ID VARCHAR(255),REFERENCE VARCHAR(16777216),LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),CHECKSUM VARCHAR(255),UPDATED TIMESTAMP DEFAULT LOCALTIMESTAMP)
CREATE UNIQUE INDEX IDX_FF_FAULT_ROW_IDS ON PUBLIC.PINPOINT_FF_FAULT_ROW(LIBRARY_ID,GROUP_ID,FILTER_ID)
CREATE UNIQUE INDEX IDX_FF_FAULT_ROW_CS ON PUBLIC.PINPOINT_FF_FAULT_ROW(CHECKSUM)
