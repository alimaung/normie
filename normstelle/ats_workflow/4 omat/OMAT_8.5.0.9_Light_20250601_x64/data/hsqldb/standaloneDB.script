CREATE MEMORY TABLE PUBLIC.ACM_ACCESS_KEY(HASHKEY VARCHAR(255) NOT NULL PRIMARY KEY,EXPIRYDATE TIMESTAMP NOT NULL,USERNAME VARCHAR(50) NOT NULL,CREATEDON TIMESTAMP NOT NULL,APPROVEDDATE TIMESTAMP,DESCRIPTION VARCHAR(250),CONSTRAINT ACM_ACCESS_KEY_USER_FK FOREIGN KEY(USERNAME) REFERENCES PUBLIC.ACM_USER(USERNAME))
