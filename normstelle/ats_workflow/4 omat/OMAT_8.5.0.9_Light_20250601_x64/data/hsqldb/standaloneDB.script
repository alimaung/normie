CREATE UNIQUE INDEX IDX_FF_FAULT_IDS ON PUBLIC.PINPOINT_FF_FAULT(LIBRARY_ID,GROUP_ID,CODE,TYPE,FILTER_ID)
CREATE UNIQUE INDEX IDX_FF_FAULT_CS ON PUBLIC.PINPOINT_FF_FAULT(CHECKSUM)
CREATE MEMORY TABLE PUBLIC.PINPOINT_FF_MESSAGE(ID INTEGER NOT NULL PRIMARY KEY,GROUP_ID VARCHAR(255),MESSAGE_NUMBER VARCHAR(255),FILTER_ID VARCHAR(255),MESSAGE VARCHAR(16777216),REFERENCE VARCHAR(16777216),LIBRARY_ID VARCHAR(255),PUBLICATION_ID VARCHAR(255),CHECKSUM VARCHAR(255),UPDATED TIMESTAMP DEFAULT LOCALTIMESTAMP)
