SET SCHEMA PUBLIC
CREATE TRIGGER PUBLIC.ACM_USERGROUPRESOURCE_CHANGE_INSERT AFTER INSERT ON PUBLIC.ACM_USERGROUPRESOURCE REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC INSERT INTO PUBLIC.ACM_TRANSACTION_LOG(RESOURCE_TYPE,RECORD_ID,PRIVILEGE_TYPE,USER_GROUP_ID,TRANSACTION_TYPE,TIMESTAMP,DETAILS)VALUES('acm_usergroupresource',NEW.URI,NEW.NAME,NEW.USERGROUPID,'INSERT',CURRENT_TIMESTAMP,CONCAT('INSERT on usergroupresource ',NEW.URI));END
CREATE TRIGGER PUBLIC.ACM_USERGROUPRESOURCE_CHANGE_UPDATE AFTER UPDATE ON PUBLIC.ACM_USERGROUPRESOURCE REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC INSERT INTO PUBLIC.ACM_TRANSACTION_LOG(RESOURCE_TYPE,RECORD_ID,PRIVILEGE_TYPE,USER_GROUP_ID,TRANSACTION_TYPE,TIMESTAMP,DETAILS)VALUES('acm_usergroupresource',NEW.URI,NEW.NAME,NEW.USERGROUPID,'UPDATE',CURRENT_TIMESTAMP,CONCAT('UPDATE on usergroupresource ',NEW.URI));END
CREATE TRIGGER PUBLIC.ACM_USERGROUPRESOURCE_CHANGE_DELETE AFTER DELETE ON PUBLIC.ACM_USERGROUPRESOURCE REFERENCING OLD ROW AS OLD FOR EACH ROW BEGIN ATOMIC INSERT INTO PUBLIC.ACM_TRANSACTION_LOG(RESOURCE_TYPE,RECORD_ID,PRIVILEGE_TYPE,USER_GROUP_ID,TRANSACTION_TYPE,TIMESTAMP,DETAILS)VALUES('acm_usergroupresource',OLD.URI,OLD.NAME,OLD.USERGROUPID,'DELETE',CURRENT_TIMESTAMP,CONCAT('DELETE on usergroupresource ',OLD.URI));END
CREATE TRIGGER PUBLIC.PINPOINT_ANNOTATION_INSERT AFTER INSERT ON PUBLIC.PINPOINT_ANNOTATION REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED)VALUES(NEW.LIBRARY_ID,NEW.PUBLICATION_ID,CONCAT('',NEW.ID),'ANNOTATION','INSERT',CONCAT('INSERT on Annotation ',NEW.ID),NEW.UPDATED);END
CREATE TRIGGER PUBLIC.PINPOINT_ANNOTATION_UPDATE AFTER UPDATE ON PUBLIC.PINPOINT_ANNOTATION REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC DECLARE OPERATION VARCHAR(255);DELETE FROM PUBLIC.PINPOINT_TRANSACTION_LOG WHERE RESOURCE_TYPE='ANNOTATION'AND RECORD_ID=CONCAT('',NEW.ID)AND LIBRARY_ID=NEW.LIBRARY_ID AND PUBLICATION_ID=NEW.PUBLICATION_ID AND TRANSACTION_TYPE='UPDATE';IF NEW.STATUS='M'THEN SET OPERATION='UPDATE';END IF;IF NEW.STATUS='D'THEN SET OPERATION='DELETE';END IF;INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED)VALUES(NEW.LIBRARY_ID,NEW.PUBLICATION_ID,CONCAT('',NEW.ID),'ANNOTATION',OPERATION,CONCAT('UPDATE on Annotation ',NEW.ID),NEW.UPDATED);END
CREATE TRIGGER PUBLIC.PINPOINT_ANNOTATION_DELETE AFTER DELETE ON PUBLIC.PINPOINT_ANNOTATION REFERENCING OLD ROW AS OLD FOR EACH ROW BEGIN ATOMIC DELETE FROM PUBLIC.PINPOINT_TRANSACTION_LOG WHERE RESOURCE_TYPE='ANNOTATION'AND LIBRARY_ID=OLD.LIBRARY_ID AND PUBLICATION_ID=OLD.PUBLICATION_ID AND RECORD_ID=CONCAT('',OLD.ID);INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED)VALUES(OLD.LIBRARY_ID,OLD.PUBLICATION_ID,CONCAT('',OLD.ID),'ANNOTATION','DELETE',CONCAT('DELETE on Annotation ',OLD.ID),CURRENT_TIMESTAMP);END
CREATE TRIGGER PUBLIC.PINPOINT_SUPPLEMENT_INSERT AFTER INSERT ON PUBLIC.PINPOINT_SUPPLEMENT REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED)VALUES(NEW.LIBRARY_ID,NEW.PUBLICATION_ID,CONCAT('',NEW.SUPPLEMENT_ID),'SUPPLEMENTS','INSERT',CONCAT('INSERT on Supplement ',NEW.SUPPLEMENT_ID),NEW.UPDATE_TIME);END
CREATE TRIGGER PUBLIC.PINPOINT_SUPPLEMENT_UPDATE AFTER UPDATE ON PUBLIC.PINPOINT_SUPPLEMENT REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC DELETE FROM PUBLIC.PINPOINT_TRANSACTION_LOG WHERE RESOURCE_TYPE='SUPPLEMENTS'AND RECORD_ID=CONCAT('',NEW.SUPPLEMENT_ID)AND LIBRARY_ID=NEW.LIBRARY_ID AND PUBLICATION_ID=NEW.PUBLICATION_ID AND TRANSACTION_TYPE='UPDATE';INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED)VALUES(NEW.LIBRARY_ID,NEW.PUBLICATION_ID,CONCAT('',NEW.SUPPLEMENT_ID),'SUPPLEMENTS','UPDATE',CONCAT('UPDATE on Supplement ',NEW.SUPPLEMENT_ID),NEW.UPDATE_TIME);END
CREATE TRIGGER PUBLIC.PINPOINT_SUPPLEMENT_DELETE AFTER DELETE ON PUBLIC.PINPOINT_SUPPLEMENT REFERENCING OLD ROW AS OLD FOR EACH ROW BEGIN ATOMIC DELETE FROM PUBLIC.PINPOINT_TRANSACTION_LOG WHERE RESOURCE_TYPE='SUPPLEMENTS'AND LIBRARY_ID=OLD.LIBRARY_ID AND PUBLICATION_ID=OLD.PUBLICATION_ID AND RECORD_ID=CONCAT('',OLD.SUPPLEMENT_ID);INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED)VALUES(OLD.LIBRARY_ID,OLD.PUBLICATION_ID,CONCAT('',OLD.SUPPLEMENT_ID),'SUPPLEMENTS','DELETE',CONCAT('DELETE on Supplement ',OLD.SUPPLEMENT_ID),CURRENT_TIMESTAMP);END
CREATE TRIGGER PUBLIC.PINPOINT_AUTHORING_CHANGE AFTER UPDATE ON PUBLIC.PINPOINT_USER_DOCUMENT REFERENCING NEW ROW AS NEW FOR EACH ROW BEGIN ATOMIC IF NEW.STATUS='APPROVED'THEN INSERT INTO PUBLIC.PINPOINT_TRANSACTION_LOG(LIBRARY_ID,PUBLICATION_ID,RECORD_ID,RESOURCE_TYPE,TRANSACTION_TYPE,DETAILS,UPDATED,NCAGE)VALUES(NEW.LIBRARY_ID,NEW.PUBLICATION_ID,NEW.DOCUMENT_ID,'AUTHORING',NEW.STATUS,CONCAT(CONCAT(NEW.STATUS,' on Authoring '),NEW.KEY),NEW.APPROVED_TIME,NEW.NCAGE);END IF;END
