<mjml>
  <mj-head>
    <mj-title>Cobalt Email Template - MJML Variant</mj-title>
    <mj-preview>Professional email template with header image</mj-preview>
    <mj-font name="RRPioneer-Regular" href="https://digital.rolls-royce.com/cobalt/RRPioneer-Regular.4acc00f6bad91e8a.woff2" />
    <mj-font name="RRPioneer-Medium" href="https://digital.rolls-royce.com/cobalt/RRPioneer-Medium.542cb6551e1d3401.woff2" />
    <mj-attributes>
      <mj-all font-family="RRPioneer-Regular, Calibri, Arial, sans-serif" />
      <mj-text font-size="16px" color="#333333" line-height="24px" />
      <mj-button background-color="#0068f0" color="white" font-size="16px" font-weight="500" border-radius="4px" />
    </mj-attributes>
    <mj-style inline="inline">
      .rr-email-logo {
        height: 26px;
        width: 22px;
      }
      .rr-project-name {
        font-size: 20px;
        font-style: normal;
        font-weight: bold;
        line-height: 24px;
        letter-spacing: -0.08px;
        font-family: RRPioneer-Medium, Calibri, Arial, sans-serif !important;
      }
      .rr-email-header {
        font-size: 28px;
        line-height: 32px;
        font-style: normal;
        letter-spacing: -0.112px;
        font-family: RRPioneer-Medium, Calibri, Arial, sans-serif !important;
        font-weight: 500;
        margin: 0;
      }
      .rr-email-text-xl {
        font-size: 20px;
        line-height: 28px;
        font-style: normal;
        font-weight: normal;
        margin: 0;
      }
      .rr-email-subheader {
        font-size: 20px;
        line-height: 24px;
        font-style: normal;
        letter-spacing: -0.08rem;
        font-family: RRPioneer-Medium, Calibri, Arial, sans-serif !important;
        font-weight: 500;
        margin: 0;
      }
      .rr-email-section-header {
        font-size: 16px;
        line-height: 24px;
        font-style: normal;
        font-family: RRPioneer-Medium, Calibri, Arial, sans-serif !important;
        font-weight: 500;
        margin: 0;
      }
      .rr-email-text {
        font-size: 16px;
        line-height: 24px;
        font-style: normal;
        font-weight: 400;
        margin: 0;
      }
      .rr-email-text-lg {
        font-size: 16px;
        line-height: 24px;
        font-style: normal;
        font-weight: 400;
      }
      .rr-email-text-gray {
        color: #636363;
      }
      .rr-email-text-sm {
        font-size: 12px;
        line-height: 18px;
        font-style: normal;
        font-weight: 400;
      }
      .rr-email-link {
        color: #0068f0;
        text-decoration: underline;
      }
      .status-icon {
        width: 16px;
        height: 16px;
        vertical-align: middle;
        margin-right: 8px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f7f7f7">
    <!-- Header Section with Logo and Project Name -->
    <mj-section background-color="#10069f" padding="16px 32px">
      <mj-column width="15%">
        <mj-image 
          src="https://digital.rolls-royce.com/cobalt/assets/email/email-rolls-royce-logo.png" 
          alt="Rolls-Royce - logo" 
          width="22px"
          height="26px"
          css-class="rr-email-logo"
          align="left"
        />
      </mj-column>
      <mj-column width="85%">
        <mj-text align="right" color="#f1f0ff" css-class="rr-project-name">
          Product Name
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Header Image Section -->
    <mj-section padding="0">
      <mj-column>
        <mj-image 
          src="https://digital.rolls-royce.com/cobalt/assets/email/email-header.png" 
          alt="Rolls-Royce - horizontal image" 
          width="600px"
          fluid-on-mobile="true"
        />
      </mj-column>
    </mj-section>

    <!-- Main Content Section -->
    <mj-section background-color="#ffffff" padding="8px 32px 12px 32px">
      <mj-column>
        <!-- Main Header -->
        <mj-text css-class="rr-email-header" padding="0 0 12px 0">
          Header
        </mj-text>

        <!-- Optional Message Summary -->
        <mj-text css-class="rr-email-text-xl" padding="0 0 12px 0">
          Optional message summary.
        </mj-text>

        <!-- Sub Header -->
        <mj-text css-class="rr-email-subheader" padding="0 0 12px 0">
          Sub header
        </mj-text>

        <!-- Section Header -->
        <mj-text css-class="rr-email-section-header" padding="0 0 12px 0">
          Section header
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Data Rows Section -->
    <mj-section background-color="#ffffff" padding="0 32px 12px 32px">
      <mj-column width="33%">
        <mj-text css-class="rr-email-text-lg rr-email-text-gray" padding="0 24px 0 0">
          List label
        </mj-text>
      </mj-column>
      <mj-column width="67%">
        <mj-text css-class="rr-email-text-lg rr-email-text-gray" padding="0 0 0 32px">
          <img src="https://digital.rolls-royce.com/cobalt/assets/email/email-check-circle-fill.png" 
               alt="Icon - Partially completed" 
               class="status-icon" />
          Status with icon
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 32px 12px 32px">
      <mj-column width="33%">
        <mj-text css-class="rr-email-text-lg rr-email-text-gray" padding="0 24px 0 0">
          List label
        </mj-text>
      </mj-column>
      <mj-column width="67%">
        <mj-text css-class="rr-email-text-lg rr-email-text-gray" padding="0 0 0 32px">
          Data
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Another Section Header -->
    <mj-section background-color="#ffffff" padding="0 32px 12px 32px">
      <mj-column>
        <mj-text css-class="rr-email-section-header" padding="0 0 12px 0">
          Section header
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Main Content Text -->
    <mj-section background-color="#ffffff" padding="0 32px 12px 32px">
      <mj-column>
        <mj-text css-class="rr-email-text">
          Duis aute irure dolor in reprehenderit in 
          <a href="#" target="_blank" class="rr-email-link">voluptate velit</a> 
          esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat 
          cupidatat non proident, sunt in culpa qui officia deserunt mollit anim 
          id est laborum.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Call to Action Button -->
    <mj-section background-color="#ffffff" padding="0 32px 12px 32px">
      <mj-column>
        <mj-button 
          href="https://digital.rolls-royce.com/cobalt"
          background-color="#0068f0"
          color="white"
          font-size="16px"
          font-weight="500"
          border-radius="4px"
          padding="16px 24px"
          width="240px"
          align="left"
        >
          Button label
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Disclaimer -->
    <mj-section background-color="#ffffff" padding="0 32px 8px 32px">
      <mj-column>
        <mj-text css-class="rr-email-text-sm rr-email-text-gray">
          Do not reply to this automatic message.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#ffffff" padding="8px 32px">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>

    <!-- Footer Section -->
    <mj-section background-color="#f7f7f7" padding="16px 0">
      <mj-column>
        <mj-text css-class="rr-email-text-sm rr-email-text-gray" align="left" padding="0 16px">
          This email was sent to email.recipient@email.com from email.sender@email.com
        </mj-text>
        
        <mj-text css-class="rr-email-text-sm rr-email-text-gray" align="left" padding="8px 16px 0 16px">
          Copyright © 2023 Rolls-Royce plc<br/>
          Registered office: Rolls-Royce plc, Kings Place, 90 York Way, London, N1 9FX<br/>
          Company number: 1003142. Registered in England.
        </mj-text>
        
        <mj-text css-class="rr-email-text-sm rr-email-text-gray" align="left" padding="8px 16px 0 16px">
          Non-Confidential - Rolls-Royce Content Only - Not Subject to Export Control
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
