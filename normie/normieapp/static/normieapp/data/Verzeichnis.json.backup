      "Eingang": "1997-07-31 00:00:00+00:00",
      "Abschluss": "1997-10-24 00:00:00+00:00",
      "Abteilung": "OM-3",
      "Einsatzort": "OU",
      "Antragsteller": "Fritzsch",
      "Antrag": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Antrag\\1997\\1997_10002255.pdf",
