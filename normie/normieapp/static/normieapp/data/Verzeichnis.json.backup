        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Schriftverkehr\\035-2018_01043237_WG%20Antrag%20Teile%20%20Stoffe%20-%20Biresin%20407.msg",
