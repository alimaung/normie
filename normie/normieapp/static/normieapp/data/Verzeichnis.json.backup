        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Gefährdungsbeurteilung\\062-2022_01042623_UCA-2M_ChemScan.pdf",
