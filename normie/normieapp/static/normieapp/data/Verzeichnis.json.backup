        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\062-2022_01042623_FW%20EXT%20RE%20UCA-2_Testreports.msg",
        "original_url": null,
        "tooltip": ""
      },
      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Schriftverkehr\\062-2022_01042623_AW%20Antrag%20für%20Teile%20%20Stoffe.msg",
