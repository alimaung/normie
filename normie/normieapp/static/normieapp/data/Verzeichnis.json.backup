      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\003-2003_10004350_FW%20Auftragsbestätigung%20zu%20Ihrer%20Bestellung%205004063287%20vom%2011.01.2019%20%20Teile-Nr.%2010004350%20.msg",
        "original_url": null,
        "tooltip": ""
      },
      "Änd. Historie": null,
      "Datum": null,
      "Bearbeiter": null,
      "=CONCATENATE(\"Bemerkung \n(\",COUNTIF(C:C,\"TBD\"),\" offene Anträge)\")": "Vorgang an Herrn Annel wegen Vergabe der Gefahrstoffnummer, 17.06.2003; Haltbarkeit und Zertifikat an H. Woelbert 07.07.2003\nÄNDERUNG: Info H&B Stoffe RR Dahlewitz am 17.01.2019 (siehe Schriftverkehr): die Gebindegröße hat sich von 200ml auf Dosen à 500ml verändert. SAP Einkaufsbestelltext wurde aktualisiert. Im Antrag selbst steht lediglich als Gebinde \"1 can\" Inhalt wird nicht erwähnt, von daher keine direkte Änderung im Antrag vorgenommen.\n03.07.2024: Antrag wurde angepasst auf die Gebinde Angabe im SAP Einkaufbestelltext. H&B Stoffe hat den Einkaufbestelltext laut Forderung von Harriet Frier angepasst (siee Verlinkung sonstiges)",
      "GSK-Nr.": 2229,
      "Lieferant": null,
      "Hersteller": null
    },
