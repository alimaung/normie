        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\062-2022_01042623_WG%20Approval%20of%20Ultrasonic%20Couplant%20to%20CSS263%20resp.%20OMat655B%20(ATS%20062_2022).msg",
