        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Antrag\\2004\\059-2004_01040031.pdf",
