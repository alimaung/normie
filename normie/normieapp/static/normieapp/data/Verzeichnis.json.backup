      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Schriftverkehr\\134-2011_01041426_AW%20Bitte%20um%20neue%20SDB%2001040004%2001041426%20%20RRD%20Dahlewitz.msg",
