      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\059-2021_10003217_WG%20Freigabe%2010003217%20-%20Antrag%200092000.msg",
        "original_url": null,
        "tooltip": ""
