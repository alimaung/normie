      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Historie\\059-2021_10003217_Historie.pdf",
