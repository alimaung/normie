        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Sonstiges\\085-2018_01042750_WG%20Bitte%20um%20QIR-Freischaltung%20für%20TKZ%2001042750%20(3102)%20%20Rückfrage%20Antrag%20Stoffe%20DW%20-%20OU.msg",
        "original_url": null,
        "tooltip": ""
      },
      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\085-2018_01042750_Antrag%20TS%20-%200852018%20(TKZ%2001042750)%20KLEBER%20762%20HIGH%20TEMP%20JOINT%20COMP.msg",
        "original_url": null,
        "tooltip": ""
      },
      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Historie\\085-2018_01042750_Historie.pdf",
        "original_url": null,
