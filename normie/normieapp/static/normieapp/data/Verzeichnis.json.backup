      "Sonstiges": null,
      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\005-2018_01043195_Anfrage%20HS&E.msg",
