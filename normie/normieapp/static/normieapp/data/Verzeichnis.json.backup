      },
      "Änd. Historie": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\060_062-2023_FW%20Sicherheits-%20und%20Technische%20Datenblätter%20RRT042314%20RRT044598%20RRT066116%20für%20Validierungen.msg",
        "original_url": null,
