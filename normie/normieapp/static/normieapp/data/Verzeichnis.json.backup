        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\030_033-2024_AfTS%20POLIERSTIFTE%20%20POLIERSCHEIBEN_Korrektur_Labor.msg",
