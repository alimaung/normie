      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Antrag\\2021\\018-2021-01043707_Freigabe_Verwendung_signed.pdf",
