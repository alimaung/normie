      "Änd. Historie": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\002-2019_01043399_KORREKTUR%20Antrag%200022019_%20TKZ%2001043399%20_%20REINIGUNGSMITTEL%20Rapide%20Wipes.msg",
