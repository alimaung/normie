      "Änd. Historie": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\227&228-2022_Anträge%20Teile%20und%20Stoffe%202272022%20und%202282022_Info_an_Antragsteller.msg",
