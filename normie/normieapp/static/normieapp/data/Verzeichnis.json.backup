      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Historie\\025-2018_01043219_Historie_DW_TKZ_10004515.pdf",
        "original_url": null,
