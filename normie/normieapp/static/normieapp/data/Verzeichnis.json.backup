      },
      "Gefährdungsprüfung": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Gefährdungsbeurteilung\\167-2019_01043506_Tri-Flow%20Lubricant%20RON014793-01.pdf",
