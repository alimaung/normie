        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\104-2009_01040920_WG%20Auftragsbestätigung%2012564538%20zu%20Ihrer%20Bestellung%205500276237.msg",
