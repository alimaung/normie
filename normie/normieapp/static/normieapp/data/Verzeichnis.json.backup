      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Historie\\046-2019_10003416_Historie.pdf",
