        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\028_034-2024_AW%20AfTS-Felt%20BobCone%20(Filzpolierstifte)-OMat547A-der%20Firme%20KEMET.msg",
