        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\012-2024_01044103_WG%20AfTS%20-%20LOCTITE%20EA%20956%20AERO-Hysol%20EA%20956.msg",
