        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\048-2023_01008969_WG%20Antrag%20auf%20Teile%20und%20Stoffe%20-%20ScotchWeld2214HT.msg",
