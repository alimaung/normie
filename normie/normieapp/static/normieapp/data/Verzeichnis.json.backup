      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Schriftverkehr\\090-2023_01041419_WG%20Antrag%20Teile%20%20Stoffe%20-%20090-2023_01041419_BESCHICHTUNG_5014%20PU%20Surfacer%20Blue%204Lt_SAP_Anpassung.msg",
        "original_url": null,
        "tooltip": ""
      },
      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Antrag\\2011\\127-2011_01041419.pdf",
        "original_url": null,
