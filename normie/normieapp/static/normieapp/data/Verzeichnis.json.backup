      "Gefährdungsprüfungeurteilung": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\Sonstiges\\167-2019_01043506.msg",
