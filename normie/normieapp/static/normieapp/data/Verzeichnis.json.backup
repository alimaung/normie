      "Änd. Historie": {
        "display_text": "pdf",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Historie\\109-2018_01043334_Produkthistorie.pdf",
        "original_url": null,
