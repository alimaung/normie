      "Schriftverkehr": {
        "display_text": "msg",
        "url": "file:///\\\\deberdna-c010a\\GlobalDE\\DocumentManagement\\Ofs\\obl\\Dokumentenservice\\TeileundStoffe\\\\Schriftverkehr\\109-2018_01043334_WG%20Angebot%20Stickstoff%205.0%20in%202%20Liter%20Flaschen.msg",
